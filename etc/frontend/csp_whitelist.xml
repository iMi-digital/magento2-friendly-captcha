<?xml version="1.0" encoding="UTF-8"?>
<csp_whitelist xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Csp:etc/csp_whitelist.xsd">
    <policies>
        <policy id="connect-src">
            <values>
                <value id="friendly_captcha" type="host">api.friendlycaptcha.com</value>
                <value id="friendly_captcha_eu" type="host">eu-api.friendlycaptcha.eu</value>
            </values>
        </policy>
        <policy id="worker-src">
            <values>
                <value id="friendly_captcha_blob" type="host">blob:</value>
                <value id="friendly_captcha_self" type="host">'self'</value>
            </values>
        </policy>
    </policies>
</csp_whitelist>
